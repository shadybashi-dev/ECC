# MALIK & OTB — environment variables (copy to .env and fill real values)
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (SQLite, file-based, real database with Prisma migrations):
DATABASE_URL="file:./dev.db"
# Staging / production (PostgreSQL example):
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"

# ── Session / auth ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET="replace-with-a-strong-random-secret"
SESSION_MAX_AGE="1209600" # 14 days in seconds

# ── Stripe (test mode until a live account is connected) ──────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Site ──────────────────────────────────────────────────────────────────
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_NAME="MALIK & OTB"
DEFAULT_FROM_EMAIL="piratespizza999@gmail.com"   # contact address; verified sender required in prod

# ── Stripe (public key exposed to browser) ────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Email (dev: emails are logged to console, not sent) ───────────────────
# RESEND_API_KEY="re_..."        # production: use a verified sender/domain
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="..."
# SMTP_PASS="..."

# ── n8n automation (optional webhooks) ────────────────────────────────────
# N8N_BASE_URL="https://n8n.example.com"
# N8N_API_KEY="..."
# N8N_WEBHOOK_SECRET="..."

# ── Feature flags ─────────────────────────────────────────────────────────
ALLOW_TEST_DATA="true"   # set "false" in staging/production to hide tagged test data
