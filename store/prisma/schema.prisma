generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// MALIK & OTB — e-commerce data model
// Money is stored in minor units (cents, Int) so it is portable between
// SQLite (local dev) and PostgreSQL (staging/production).
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  PENDING
  PARTIAL
  FULFILLED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  passwordHash  String
  role          UserRole    @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions      Session[]
  orders        Order[]
  cart          Cart?
  auditLogs     AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expires])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  seoTitle    String?
  seoDesc     String?

  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  description       String?
  shortDesc         String?
  sku               String?     @unique
  status            ProductStatus @default(DRAFT)
  trackInventory    Boolean     @default(true)
  lowStockThreshold Int         @default(5)
  basePriceCents    Int
  weightKg          Float?
  dimensionsCm      String?
  materials         String?
  care              String?
  usage             String?
  restrictions      String?
  shippingInfo      String?
  returnInfo        String?
  seoTitle          String?
  seoDescription    String?
  isFeatured        Boolean     @default(false)
  testData          Boolean     @default(false) // tagged test data: noindex, not purchasable
  createdById       String?
  createdBy         User?       @relation(fields: [createdById], references: [id])
  publishedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  String?
  variants    Variant[]
  images      ProductImage[]
  orderItems  OrderItem[]

  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@index([testData])
}

model Variant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  sku         String   @unique
  name        String
  priceAdjCents Int    @default(0) // cents adjustment vs base price
  stock       Int      @default(0)
  reserved    Int      @default(0) // units held in open checkouts/carts
  isDefault   Boolean  @default(false)
  barCode     String?  @unique // GTIN only when actually supplied by the vendor
  weightKg    Float?
  active      Boolean  @default(true)
  orderItems  OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([barCode])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)

  @@index([productId])
  @@index([isPrimary])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?   // anonymous cart key
  items     CartItem[]
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([sessionId])
  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  quantity  Int      @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  email              String      // customer email captured at checkout
  status             OrderStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)
  fulfillmentStatus  FulfillmentStatus @default(UNFULFILLED)
  subtotalCents      Int
  taxCents           Int         @default(0)
  shippingCents      Int         @default(0)
  discountCents      Int         @default(0)
  totalCents         Int
  currency           String      @default("USD")
  stripePaymentIntentId String?
  stripeChargeId     String?
  idempotencyKey     String?
  billingAddress     Json?
  shippingAddress    Json?
  notes              String?
  items              OrderItem[]
  auditLogs          AuditLog[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([orderNumber])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  sku         String   // snapshot at purchase
  name        String   // snapshot at purchase
  quantity    Int
  unitPriceCents Int
  priceAdjCents   Int   @default(0)
  totalCents    Int
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
