# claude-token-saver — copy to .env and fill in. NEVER commit .env.
# cp .env.example .env

# The ONLY way cts reads your key (never as a CLI argument).
ANTHROPIC_API_KEY=

# Optional defaults:
# CTS_MODEL=claude-sonnet-4-6
# CTS_CACHE_DIR=
# CTS_MAX_PROMPT_BYTES=1048576
# CTS_TIMEOUT_MS=120000
# CTS_ALLOWED_HOSTS=
# CTS_ALLOWED_MODELS=
# CTS_ABORT_ON_SECRET=0
# CTS_PRICES_JSON=
# CTS_ANTHROPIC_BETAS=

# DANGER ZONE — only if you run a trusted proxy/mirror:
# CTS_ALLOW_BASE_URL=1
