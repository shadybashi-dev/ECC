  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "qrcode.react": "^4.2.0",
