{
  "name": "restaurant-tv-menu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Digital menu board for restaurant TV screens (1920x1080) - built with the newest open-source tools from GitHub",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
