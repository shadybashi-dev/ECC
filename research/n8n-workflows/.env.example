# Copy to .env on the server and edit. Never commit .env or paste secrets into workflow JSON.
N8N_DOMAIN=n8n.example.com
# Pin an exact release tag after checking current n8n docs/releases; do not leave this as latest.
N8N_VERSION=REPLACE_WITH_TESTED_N8N_VERSION
QDRANT_VERSION=REPLACE_WITH_TESTED_QDRANT_VERSION
GENERIC_TIMEZONE=America/Los_Angeles

POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=n8n
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_STABLE_RANDOM_32_PLUS_CHARACTER_SECRET
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_SEPARATE_LONG_RANDOM_SECRET
